# Copy these into Vercel -> Project -> Settings -> Environment Variables.
# Locally they live in .env, which is gitignored.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server only. Used once, to create the first admin at /admin/setup.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# --- Postgres ---------------------------------------------------------------
# DATABASE_URL is the TRANSACTION pooler (6543) — short serverless queries.
# DIRECT_URL is the SESSION pooler (5432) — schema pushes and migrations.
# Pointing the Prisma CLI at 6543 makes `prisma db push` hang forever.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Google Sheets webhook --------------------------------------------------
# Any long random string. The same value goes into the Apps Script bound to
# each sheet (scripts/apps-script/notify-dashboard.gs).
SHEETS_WEBHOOK_SECRET=
